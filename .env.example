# ============================================================
#  Configuration — copier ce fichier en ".env" et remplir les valeurs.
#  Le fichier .env est ignoré par git (.gitignore).
# ============================================================

# --- Base de données ---
DB_DSN=mysql:host=db;dbname=nature_folio
DB_USERNAME=nature_folio
DB_PASSWORD=change-moi

# MySQL (service db de docker-compose)
MYSQL_ROOT_PASSWORD=change-moi
MYSQL_DATABASE=nature_folio
MYSQL_USER=nature_folio
MYSQL_PASSWORD=change-moi

# --- Site ---
# URL publique du site (https://...), sans slash final
SITE_URL=https://nature.lucaslaplanche.fr

# --- Matomo (analytics auto-hébergé, remplace Google Analytics) ---
MATOMO_URL=https://matomo.example.com
MATOMO_SITE_ID=1

# --- Admin ---
# Hash bcrypt du mot de passe d'administration.
# Générer avec : php -r "echo password_hash('ton-mot-de-passe', PASSWORD_DEFAULT);"
ADMIN_PASSWORD_HASH=change-moi
